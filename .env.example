# --- CRM API (existing /api/crm/* routes secured with x-api-key) ---
CRM_API_BASE_URL=https://crm.rowanroseclaims.co.uk/api/crm
CRM_API_KEY=replace-with-CRM_API_KEY-from-crm-server-env

# --- MCP server bearer token (Claude Code uses this) ---
MCP_API_KEY=generate-a-long-random-string

# --- HTTP transport ---
MCP_PORT=5050
MCP_BIND=127.0.0.1

# --- Logging ---
LOG_LEVEL=info
NODE_ENV=production
